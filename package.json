{
  "name": "iris",
  "productName": "Iris",
  "private": true,
  "version": "0.1.0",
  "description": "여러 코딩 에이전트와 브라우저와 문서를 한 화면에서 다루는 개인용 관제 콘솔 (macOS)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backend-seungjae-song/Iris.git"
  },
  "homepage": "https://github.com/backend-seungjae-song/Iris",
  "bugs": "https://github.com/backend-seungjae-song/Iris/issues",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.2",
  "type": "module",
  "main": "native/electron/main.cjs",
  "scripts": {
    "agent:context": "node bin/agent-context.mjs",
    "agent:run": "node bin/agent-run.mjs",
    "start": "node server/index.js",
    "app": "node scripts/run-dev.mjs app",
    "build:docx-vendor": "esbuild scripts/docx-editor-core.entry.js --bundle --format=esm --platform=browser --external:module --minify --outfile=web/vendor/docx-editor-core.esm.js --metafile=web/vendor/docx-editor-core.meta.json",
    "build:vendor": "node scripts/build-vendor.mjs",
    "dev": "node scripts/run-dev.mjs server",
    "dev:app": "node scripts/run-dev.mjs app",
    "dev:seed": "node scripts/run-dev.mjs seed",
    "dist": "electron-builder --mac --arm64",
    "dist:win": "node scripts/dist-win.mjs",
    "export:public": "node scripts/export-public.mjs",
    "sync:public": "node scripts/sync-public.mjs",
    "pull:public": "node scripts/pull-public.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "install:app": "node scripts/install-app.mjs",
    "prepare": "node scripts/build-vendor.mjs",
    "selftest": "node server/selftest.js",
    "smoke": "node bin/smoke.mjs",
    "test": "node scripts/run-tests.mjs",
    "release-audit": "node scripts/release-audit.mjs"
  },
  "build": {
    "appId": "app.iris.console",
    "productName": "Iris",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "bin/agent-context.mjs",
      "bin/iris-session.mjs",
      "bin/agent-run.mjs",
      "native/**/*",
      "server/**/*",
      "web/**/*",
      "package.json",
      "!node_modules/monaco-editor/**"
    ],
    "asarUnpack": [
      "bin/agent-context.mjs",
      "bin/iris-session.mjs",
      "bin/agent-run.mjs",
      "package.json",
      "server/**",
      "web/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/serve-sim",
        "to": "node_modules/serve-sim",
        "filter": [
          "package.json",
          "LICENSE*",
          "dist/**",
          "bin/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "브라우저 탭과 창을 실제 클릭·입력으로 조작하기 위해 시스템 이벤트를 씁니다.",
        "NSLocationUsageDescription": "사이트가 위치 정보를 요청하고 사용자가 허용한 경우에만 현재 위치를 알려 줍니다.",
        "NSAudioCaptureUsageDescription": "에뮬레이터 탭의 기기 소리 크기를 기기마다 따로 조절하기 위해 그 기기의 소리를 받아 다시 재생합니다.",
        "LSUIElement": false
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "dist/herdr-win",
          "to": "herdr",
          "filter": [
            "**/*",
            "!.version"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "scripts/windows-installer.nsh",
      "runAfterFinish": false
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "dependencies": {
    "@docx-editor.dev/core": "2.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "asn1js": "3.0.10",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "pkijs": "3.4.0",
    "puppeteer-core": "25.10.0",
    "tldts": "7.4.11",
    "uqr": "0.1.3",
    "ws": "^8.21.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "serve-sim": "0.1.40"
  },
  "pnpm": {
    "overrides": {
      "unzipper": "^0.12.3"
    },
    "patchedDependencies": {
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    }
  }
}
